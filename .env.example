# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=models/gemini-flash-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# --- Supabase Postgres (pgvector 768-dim) -- PICK ONE FORMAT ---
# FORMAT A (RECOMMENDED for this pipeline - direct Postgres via psycopg2):
#   Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
#   Copy EXACTLY, single line, NO spaces, NO line-breaks:
SUPABASE_DB_URL=postgresql://postgres:<DB-PASSWORD>@db.kgdiydsokitpmpzwzwje.supabase.co:5432/postgres
#   <DB-PASSWORD> = database password you set at project creation (NOT the anon JWT eyJ...).
#   If password has @ # / ? : %, URL-encode them (%40 %23 %2F %3F %3A %25).
#   Pooler (IPv4 / GitHub Actions, recommended if direct fails):
#   SUPABASE_DB_URL=postgresql://postgres.kgdiydsokitpmpzwzwje:<DB-PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# FORMAT B (ALTERNATE - REST client via supabase-py, no password needed):
#   Supabase Dashboard -> Project Settings -> API -> Project URL + anon public key
#SUPABASE_URL=https://kgdiydsokitpmpzwzwje.supabase.co
#SUPABASE_KEY=eyJhbGciOi...your-anon-key

# --- Tally form (free, unlimited responses) ---
# Create key: tally.so -> Settings -> API -> Create key. Form ID from URL tally.so/r/<ID>.
TALLY_API_KEY=
TALLY_FORM_ID=QKgdWX

# --- Legacy Google Sheets (optional backup, no longer required) ---
GOOGLE_SHEET_NAME=Job Newsletter Subscribers
# Optional: open by ID instead of name (from sheet URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
# Option A (KEYLESS, recommended w/ iam.disableServiceAccountKeyCreation):
#  GCP Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#  -> Desktop app -> download JSON -> save as oauth_client.json in project root.
#  First run opens browser for consent and creates token.json automatically.
GCP_OAUTH_CLIENT_FILE=oauth_client.json
GCP_OAUTH_TOKEN_FILE=token.json
# Option B (legacy SA file, blocked if org sets iam.disableServiceAccountKeyCreation)
GCP_SERVICE_ACCOUNT_FILE=gcp_key.json
# Option C (CI legacy SA JSON string - leave empty locally; blocked by same org policy)
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# Option D (CI keyless): Workload Identity Federation - set GOOGLE_APPLICATION_CREDENTIALS
#  via google-github-actions/auth@v2 with workload_identity_provider + service_account.

# --- Email (Brevo primary 300/day free; Resend fallback 100/day) ---
# Brevo setup (5 min): app.brevo.com -> Settings -> Senders -> Add/verify your Gmail
# -> Settings -> SMTP & API -> API Keys -> Generate v3 key (xkeysib-...) -> paste below.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FireflyLabz Jobs
# Fallback (Resend test domain only sends to signup email):
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=FireflyLabz Jobs <newsletter@yourdomain.com>

# --- Brand assets (hosted HTTPS URLs for email <img>) ---
# Save attached files to assets/logo-light.png (navy on white),
# assets/logo-dark.png (gold on black), assets/banner-dark.png (wide gold banner),
# then host publicly (Supabase Storage public bucket OR GitHub raw) and paste URLs here.
# Email clients block local files - must be https:// public URLs.
LOGO_LIGHT_URL=https://example.com/assets/fireflylabz-logo-light.png
LOGO_DARK_URL=https://example.com/assets/fireflylabz-logo-dark.png
BANNER_URL=https://example.com/assets/fireflylabz-banner-dark.png
BRAND_WEBSITE=https://fireflylabz.example.com
# --- Unsubscribe (one-click, $0) ---
# Host unsubscribe_page.py on Streamlit (free), then set:
#UNSUBSCRIBE_BASE_URL=https://<your-app>.streamlit.app
# Generate once: python -c "import secrets; print(secrets.token_hex(16))"
#UNSUBSCRIBE_SECRET=change-me-32-hex
# Until set, footer uses "Reply STOP" mode (still compliant).
# --- Pipeline tuning ($0 guardrails) ---
# Brevo-safe default is 300/run (300/day free). Resend test is 100/day.
MAX_SUBSCRIBERS_PER_RUN=100
# Sleep between subscriber iterations to respect Gemini 1.5 Flash 15 RPM free limit.
# Each iteration makes 1x embedding (1500 RPM quota, separate) + 1x LLM call -> 4.5s keeps LLM < 14 RPM.
THROTTLE_SECONDS=4.5
# Only jobs from last N days are considered (14d matches Supabase cleanup + strategy doc)
JOB_LOOKBACK_DAYS=14
# Set to true to run without sending emails / writing to sheets
DRY_RUN=false
